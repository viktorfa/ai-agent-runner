#!/usr/bin/env bash
# Append one CSV row per NEW completed, work-doing drain — the mechanical half of the
# agent metrics (see the product repos' docs/AGENT_METRICS.md). Runs as the OPERATOR;
# reads agent-owned transcripts + git via `sudo -iu <repo user>`. Idempotent: per repo
# it only collects drains newer than the last one already recorded, so re-runs and the
# 5-min timer never duplicate. Fired by agent-metrics.timer.
#
# Model/effort are attributed from the transcript when available, with each drain's
# merged auto/work commit as the fallback for older logs.
set -uo pipefail

CONFIG_DIR="${AGENT_RUNNER_CONFIG:-$HOME/.config/agent-runner}"
MDIR="$CONFIG_DIR/metrics"
CSV="$MDIR/drains.csv"
EXTRACT="/home/agent/agent-runner/control/bin/drain-metrics-extract"
HEADER="start,end,wall_s,repo,model,effort,merged_hash,n_tasks,tasks,staged,parked,blocked,failures,status,turns,output_tokens,reasoning_tokens,input_uncached,cached_input"

mkdir -p "$MDIR"
exec 9>"$MDIR/.collect.lock"
flock -n 9 || exit 0   # a run is already in progress — skip this tick
[ -f "$CSV" ] || printf '%s\n' "$HEADER" >"$CSV"

for conf in "$CONFIG_DIR"/repos/*.conf; do
	name=$(basename "$conf" .conf)
	repo_path=$(grep -m1 '^REPO_PATH=' "$conf" | cut -d'"' -f2)
	repo_user=$(grep -m1 '^REPO_USER=' "$conf" | cut -d'"' -f2)
	[ -n "$repo_path" ] || continue
	[ -n "$repo_user" ] || repo_user=agent
	# Newest start already recorded for this repo, converted back to the filename stamp
	# form (ISO 2026-07-11T08:11:04 -> 2026-07-11T08-11-04). Empty on the first run for
	# a repo -> the extractor backfills its work-doing drains.
	after=$(awk -F, -v r="$name" '$4==r{print $1}' "$CSV" | sort | tail -1 | tr ':' '-')
	sudo -iu "$repo_user" python3 "$EXTRACT" \
		--repo-path="$repo_path" --repo-name="$name" ${after:+--after="$after"} \
		>>"$CSV" 2>/dev/null
done
